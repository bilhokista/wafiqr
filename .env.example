# Which Stellar network: "testnet" (default) or "mainnet". Mainnet moves real
# money and refuses to start without VITE_ARBITER_ADDRESS.
VITE_STELLAR_NETWORK=testnet

# Optional. Soroban RPC used to check which code an escrow contract runs before
# it is funded. Defaults to a public endpoint per network.
VITE_SOROBAN_RPC_URL=

# Optional. SHA-256 of the Trustless Work escrow WASM the app will fund. The
# default is the version checked on 2026-09-25; change it only after reviewing
# a new release.
VITE_TW_ESCROW_WASM_HASH=

# Trustless Work API key for that network — https://dapp.trustlesswork.com
# Read-only calls work without it; deploy, fund and release require it.
VITE_TW_API_KEY=

# Firebase web app config (Project settings -> Your apps -> Web app)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Stellar accounts. The arbiter must differ from buyer and seller: the contract
# rejects a dispute opened by its own dispute resolver.
VITE_ARBITER_ADDRESS=

# DHL Shipment Tracking (read-only), from https://developer.dhl.com/tracking
# Optional. Without it a waybill is recorded exactly as the seller typed it and
# the deal room says it is unverified — which is the truth, and better than a
# tick nobody earned. The free tier is 250 calls a day.
#
# It ships in the bundle like every VITE_ variable, so anyone can read it from
# the page and spend the quota. Acceptable for a pilot; move it behind a proxy
# before real deals run through here.
VITE_DHL_API_KEY=
