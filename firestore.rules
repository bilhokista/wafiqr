rules_version = '2';

// Lots are public to read — a buyer must be able to inspect the goods before
// trusting a stranger — but deals are private to their two parties, and only
// the parties to a record may write it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      function validProfile() {
        return request.resource.data.uid == uid
          && request.resource.data.role in ['buyer', 'seller']
          && request.resource.data.get('country', '') is string
          && request.resource.data.get('country', '').size() <= 60;
      }

      allow read: if signedIn();
      allow create: if isSelf(uid) && validProfile();
      // Country is what the cross-border rule on deals reads, so once set it
      // stays set: flipping it per deal would make that rule decorative. It is
      // still self-declared — the licensed exchanges each party pays through
      // hold the verified identity; this stops the cheap lie, not every lie.
      allow update: if isSelf(uid) && validProfile()
        && (resource.data.get('country', '') == ''
          || request.resource.data.get('country', '') == resource.data.get('country', ''));
      allow delete: if false;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSelf(request.resource.data.sellerUid)
        && request.resource.data.pricePerUnit is number
        && request.resource.data.pricePerUnit >= 0
        && request.resource.data.minOrder is number
        && request.resource.data.minOrder > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.specs is string
        && request.resource.data.specs.size() > 0
        && request.resource.data.category in ['spice', 'coffee', 'craft', 'textile']
        && request.resource.data.leadTimeDays is number
        && request.resource.data.leadTimeDays > 0;
      // A seller may edit their own lot but never reassign it to someone else,
      // and never point the payout at a different wallet mid-sale.
      allow update: if isSelf(resource.data.sellerUid)
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.sellerWallet == resource.data.sellerWallet;
      allow delete: if isSelf(resource.data.sellerUid);
    }

    match /deals/{dealId} {
      function isParty() {
        return signedIn()
          && (request.auth.uid == resource.data.buyerUid || request.auth.uid == resource.data.sellerUid);
      }

      // Deals are private: only the buyer and the seller who opened them may read.
      allow read: if isParty();

      function countryOf(uid) {
        return get(/databases/$(database)/documents/users/$(uid)).data.get('country', '').lower().trim();
      }

      function isIndonesia(country) {
        return country in ['indonesia', 'id', 'idn', 'ri', 'republik indonesia', 'republic of indonesia'];
      }

      // Settling in USDC is lawful for wafiqr only across a border: Law 4/2026
      // forbids a stablecoin as payment inside Indonesia. The app says this in
      // words (src/lib/crossBorder.ts); the rule makes it true for anyone who
      // skips the app.
      function crossesBorder(buyerUid, sellerUid) {
        let buyer = countryOf(buyerUid);
        let seller = countryOf(sellerUid);
        return buyer != '' && seller != '' && buyer != seller
          && !(isIndonesia(buyer) && isIndonesia(seller));
      }

      // The buyer opens the deal, and the money figure must match the line items.
      allow create: if isSelf(request.resource.data.buyerUid)
        && crossesBorder(request.resource.data.buyerUid, request.resource.data.sellerUid)
        && request.resource.data.status == 'draft'
        && request.resource.data.contractId == ''
        && request.resource.data.evidence.size() == 0
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      // Terms are frozen once the deal exists. Only status, contract id, evidence
      // and the timestamp may move, and only a party to the trade may move them.
      allow update: if isParty()
        && request.resource.data.buyerUid == resource.data.buyerUid
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.buyerWallet == resource.data.buyerWallet
        && request.resource.data.sellerWallet == resource.data.sellerWallet
        && request.resource.data.arbiterWallet == resource.data.arbiterWallet
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.specs == resource.data.specs
        && request.resource.data.incoterm == resource.data.incoterm
        && request.resource.data.shipBy == resource.data.shipBy;

      allow delete: if false;
    }

    // Payouts are NOT public, unlike listings and deals.
    //
    // A deal is public because a buyer has to be able to inspect it before
    // trusting a stranger. A payout carries the seller's bank — masked, and
    // still nobody else's business. The full account number is never written
    // here at all: it goes to the licensed provider at submission time and is
    // not persisted, so this document holds a masked tail and a reference.
    match /payouts/{dealId} {
      function deal() {
        return get(/databases/$(database)/documents/deals/$(dealId)).data;
      }

      function isSeller() {
        return signedIn() && request.auth.uid == deal().sellerUid;
      }

      function isParty() {
        return signedIn()
          && (request.auth.uid == deal().sellerUid || request.auth.uid == deal().buyerUid);
      }

      // The buyer may read it, because "have you been paid" is a fair question
      // from the person who paid.
      allow read: if isParty();

      // Only the seller starts a payout, and only for the amount the escrow
      // actually released.
      allow create: if isSeller()
        && request.resource.data.dealId == dealId
        && request.resource.data.usdcAmount is number
        && request.resource.data.usdcAmount > 0
        && request.resource.data.usdcAmount <= deal().amount
        && request.resource.data.rail in ['wallet', 'bank', 'exchange'];

      // The figure is frozen once the payout exists. Status, quote, settlement
      // and failure text may move; the amount may not.
      allow update: if isSeller()
        && request.resource.data.dealId == resource.data.dealId
        && request.resource.data.usdcAmount == resource.data.usdcAmount
        && request.resource.data.rail in ['wallet', 'bank', 'exchange'];

      allow delete: if false;
    }

    // A sealed embedded wallet. Ciphertext under a passphrase wafiqr never
    // sees, readable by its owner only, so they can recover on a new device.
    // Overwrite is allowed because restoring from a written-down secret
    // re-seals it under a new passphrase; the public key may not change,
    // because a vault that silently swaps keys would strand escrows.
    match /vaults/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.publicKey is string
        && request.resource.data.sealed.ciphertext is string;
      allow update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.publicKey == resource.data.publicKey
        && request.resource.data.sealed.ciphertext is string;
      allow delete: if false;
    }

    // What only the owner should read: the exchange deposit memo ties a person
    // to their exchange account.
    match /private/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && request.resource.data.uid == uid;
      allow delete: if isSelf(uid);
    }
  }
}
